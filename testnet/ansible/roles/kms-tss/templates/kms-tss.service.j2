[Unit]
Description=Signet TSS Key Management Service
Before=signetd.service

[Service]
Type=simple
User={{ signetd_user }}
Group={{ signetd_user }}
# No ExecStartPre=rm -f on the socket. Unlinking the path unconditionally, from
# outside the process, destroys a *live* instance's socket whenever a second one
# starts — turning a benign lock conflict into a total outage (see the kms-frost
# race in roles/kms-tss/tasks/main.yml). kms-tss clears a genuinely stale socket
# itself, but only after taking the sled lock, which proves no peer is serving.
ExecStart={{ kms_bin }} {{ kms_socket }} {{ kms_data_dir }}
{% if kms_at_rest_encryption | default(false) | bool %}
# At-rest encryption KEK. Deliberately an EnvironmentFile and NOT Environment=:
# this unit is mode 0644 and `systemctl show kms-tss` renders Environment= to any
# user, so an inline KEK would be world-readable on the box. The file is 0600.
#
# No leading '-'. A missing file must fail the unit, because kms-tss treats an
# absent SIGNET_KMS_KEY as "encryption off" (src/main.rs:97) and will silently
# open a PLAINTEXT store instead. Failing to start is the safe outcome; quietly
# writing unencrypted shards is not.
EnvironmentFile={{ kms_env_file }}
{% endif %}
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
Environment=RUST_LOG=kms_tss={{ log_level | default('info') }}

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kms-tss

[Install]
WantedBy=multi-user.target
